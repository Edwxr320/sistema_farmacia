# =============================================================================
# PHARMA PLUS - Variables de entorno
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Nivel de registro: fatal | error | warn | info | debug
LOG_LEVEL=info
# Si la app corre detrás de un proxy inverso (nginx, etc.), ponga 1. En local: 0
TRUST_PROXY=0
# Orígenes permitidos para peticiones que modifican datos (separados por coma).
# Vacío = solo el mismo origen que sirve la API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Base de datos MariaDB (XAMPP) ---------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Usuario restringido de la aplicación (ver database/setup/01_crear_usuario_pharma_app.sql).
# No use root.
DB_USER=pharma_app
DB_PASSWORD=
DB_NAME=pharma_plus
DB_CONNECTION_LIMIT=10

# --- Autenticación -------------------------------------------------------------
# Secretos aleatorios de al menos 32 caracteres. Genérelos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
# Duración de la sesión (minutos)
SESSION_TTL_MINUTES=480
# Costo bcrypt (12 o más)
BCRYPT_COST=12
# Política de bloqueo por intentos fallidos. Si en la tabla settings existen
# security.max_failed_logins / security.lockout_minutes, se usan esos valores.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Límite de peticiones de login por IP en la ventana indicada
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Archivos e imágenes ---
# Carpeta de imágenes subidas (en la BD solo se guarda la ruta /uploads/...)
UPLOADS_DIR=
UPLOAD_MAX_IMAGE_KB=2048

# --- Tareas programadas ---
JOBS_ENABLED=true
# Hora (America/Lima) de CALL sp_refresh_expiry_alerts()
EXPIRY_ALERTS_HOUR=6
