# Dependencias
node_modules/
frontend/node_modules/

# Build del frontend (se genera con npm run build)
frontend/dist/

# Variables de entorno y credenciales (solo se versiona .env.example)
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
secrets*.json

# Registros, cobertura y temporales
logs/
*.log
coverage/
.nyc_output/
*.lcov
npm-debug.log*
tmp/
temp/
.cache/
scratchpad/
*.tmp

# Copias de seguridad, comprimidos y volcados de base de datos
backup*/
backups/
*.bak
*.zip
*.tgz
*.tar
*.tar.gz
*.7z
*.rar
*.sql.gz
*.sql.bak
dump*.sql
*_dump.sql

# Imágenes subidas por los usuarios (en producción viven en UPLOADS_DIR, fuera del repositorio)
uploads/

# Copias de trabajo de imágenes de producto: las que usa la app están en frontend/src/assets/store/products/
pharma_plus_productos_png/

# Capturas de depuración de pruebas fallidas (las evidencias válidas sí se versionan)
evidencias/**/*-fallo.png

# Bocetos de diseño: referencias del proceso de diseño, conservadas fuera del repositorio
# (no son necesarios para ejecutar Pharma Plus)
Bocetos/

# Sistema operativo y editores
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
.idea/
