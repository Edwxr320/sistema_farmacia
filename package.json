{
  "name": "pharma-plus",
  "version": "0.1.0",
  "description": "Pharma Plus - Sistema web integral para botica (React + Vite, API Node.js + Express + MariaDB)",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite frontend",
    "build": "vite build frontend",
    "admin:create": "node scripts/create-admin.js",
    "db:check": "node scripts/check-db.js",
    "settings:security": "node scripts/seed-security-settings.js",
    "sessions:cleanup": "node scripts/cleanup-sessions.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:tempdb": "node scripts/test-tempdb.js",
    "test:e2e": "node scripts/test-tempdb.js \"tests/e2e/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "pretest": "npm run build",
    "pretest:tempdb": "npm run build",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "pino-pretty": "^13.2.0",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "vite": "^6.4.6"
  }
}
